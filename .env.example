# ==============================================================================
# PullWard AI - Environment Variable Template
# Copy this file to '.env' and fill in your actual credentials.
# DO NOT commit the '.env' file to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini AI API Configuration
# ------------------------------------------------------------------------------
# Your API Key from Google AI Studio or GCP AI Platform
GEMINI_API_KEY="your_gemini_api_key_here"

# Model selection for orchestrator and agent routing
GEMINI_MODEL="gemini-2.5-flash"

# ------------------------------------------------------------------------------
# 2. Google Cloud Platform (GCP) Project Settings
# ------------------------------------------------------------------------------
GCP_PROJECT_ID="pullward-ai"
GCP_REGION="us-central1"

# Path to service account credentials JSON (if running locally outside gcloud auth)
# GOOGLE_APPLICATION_CREDENTIALS="path/to/service_account_key.json"

# ------------------------------------------------------------------------------
# 3. BigQuery & Firestore Storage Settings
# ------------------------------------------------------------------------------
BIGQUERY_DATASET="pullward_audit"
FIRESTORE_DATABASE_ID="(default)"

# ------------------------------------------------------------------------------
# 4. GitHub Integration (App / Webhook Setup - Future Phases)
# ------------------------------------------------------------------------------
GITHUB_APP_ID="your_github_app_id"
GITHUB_WEBHOOK_SECRET="your_webhook_secret_key"
# GITHUB_PRIVATE_KEY_PATH="path/to/private-key.pem"